# Sinilink XY-Clock: ESP8285H16, 2 MB internal flash, 26 MHz crystal.
# DOUT is mandatory: GPIO9/GPIO10 (the flash's quad data lines) are buttons.
CONFIG_ESPTOOLPY_FLASHMODE_DOUT=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_BAUD_230400B=y
CONFIG_ESPTOOLPY_MONITOR_BAUD_115200B=y
CONFIG_ESP8266_XTAL_FREQ_26=y
CONFIG_ESP8266_DEFAULT_CPU_FREQ_160=y
CONFIG_PARTITION_TABLE_TWO_OTA=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# NTP: up to 4 servers with failover (design §5.1).
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=4
# Firmware uploads: verify the appended SHA-256 as well as the checksum (§11).
CONFIG_APP_UPDATE_CHECK_APP_SUM=y
CONFIG_APP_UPDATE_CHECK_APP_HASH=y
# Room for the Authorization header and longer requests.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# mDNS (<hostname>.local, design §4.5). Selects LWIP_IPV6.
CONFIG_ENABLE_MDNS=y
CONFIG_MDNS_MAX_SERVICES=2
